# Copia este fichero como .env y ajusta los valores.

# Imagen a usar. Con el fichero .tar.gz cargado (docker load) es deca-server:0.1.0.
# Si la subes a un registro: DECA_IMAGE=ghcr.io/<usuario>/deca-server:0.1.0
DECA_IMAGE=deca-server:0.1.0

# Enlace HTTPS de Cloudflare Tunnel para acceder desde fuera y para los QR.
# Vacío = se detecta automáticamente la primera vez que se entra por el túnel.
DECA_PUBLIC_URL=https://deca.tu-dominio.es

# Dirección y puerto en la máquina anfitriona (dentro del contenedor siempre 8134).
DECA_BIND_ADDRESS=0.0.0.0
DECA_HOST_PORT=8134

# Datos: "deca-data" (volumen de Docker, por defecto) o la RUTA ABSOLUTA de una carpeta
# del anfitrión (debe pertenecer al UID 10001: sudo chown -R 10001 /ruta).
DECA_DATA=deca-data
# DECA_DATA=/srv/deca/data
