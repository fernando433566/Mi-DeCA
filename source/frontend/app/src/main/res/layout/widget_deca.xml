<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="4dp">


    <LinearLayout
        android:id="@+id/w_body"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.75"
        android:background="@drawable/ticket_body"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <TextView android:id="@+id/w_kind" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DeCA · DOCUMENTO DE CONTROL" android:textColor="#0B4EA2" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.1" />
        <TextView android:id="@+id/w_num" android:layout_width="match_parent" android:layout_height="24dp"
            android:text="Sin DeCA todavía" android:textColor="#15171A" android:textSize="17sp" android:textStyle="bold" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="17sp" />
        <TextView android:id="@+id/w_route" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:text="Abre la app para crear uno" android:textColor="#15171A" android:textSize="13sp" android:ellipsize="end" android:maxLines="3" android:layout_marginTop="2dp" />
        <TextView android:id="@+id/w_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#50555C" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_stub"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/ticket_stub"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end"
            android:text="" android:textColor="#073575" android:textSize="12sp" android:textStyle="bold" />
        <ImageView android:id="@+id/w_qr" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1"
            android:adjustViewBounds="true" android:scaleType="fitCenter" android:contentDescription="Código QR del DeCA" />
    </LinearLayout>

</LinearLayout>
