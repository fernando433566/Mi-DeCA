<?xml version="1.0" encoding="utf-8"?>
<!-- Parte derecha del billete (matriz), separada por línea discontinua -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#FFFDF6" /><corners android:topRightRadius="16dp" android:bottomRightRadius="16dp" /></shape></item>
    <item android:width="2dp" android:gravity="left" android:top="10dp" android:bottom="10dp">
        <shape android:shape="line"><stroke android:color="#9AA0A6" android:width="2dp" android:dashWidth="5dp" android:dashGap="4dp" /></shape>
    </item>
</layer-list>
